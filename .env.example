# Frontend env vars
#
# Default setup:
# - Local dev uses the Vite proxy for "/api" -> http://localhost:3000
# - Vercel production uses API_BASE_URL in Project Settings and frontend/vercel.mjs
#
# Optional override:
# If you want the browser to call the backend directly instead of using the
# Vercel proxy, uncomment this and set your Railway origin.
#
# VITE_API_BASE_URL=https://your-backend.up.railway.app

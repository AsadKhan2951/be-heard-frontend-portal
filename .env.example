# Frontend does not require any env vars for the default setup.
#
# API requests use relative "/api" paths:
#   - In local dev  -> Vite proxies "/api" to http://localhost:3000 (see vite.config.js)
#   - In production -> Vercel rewrites "/api" to your Railway backend (see vercel.json)
#
# So instead of an env var, set your backend URL in vercel.json.
